# Auto detect text files and normalize line endings to LF
* text=auto

# Explicitly set line endings for key file types
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
